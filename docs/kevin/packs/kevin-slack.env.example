# Kevin profile Slack / gateway env (names only)
# Copy into: ~/.hermes/profiles/kevin/.env
# Never commit real tokens.
# Path of record: docs/runbooks/kevin-slack-live.md

# Required (Socket Mode)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Hard allowlists (required before any live gateway use)
# Member IDs: Slack profile → … → Member ID (U…)
# Channel IDs: channel details → About → bottom (C…)
SLACK_ALLOWED_USERS=U…
SLACK_ALLOWED_CHANNELS=C…
# Do NOT set SLACK_ALLOW_ALL_USERS=true for kevin

# Optional home channel
# SLACK_HOME_CHANNEL=C…

# After setting tokens + allowlists:
#   hermes -p kevin gateway setup   # if needed
#   hermes -p kevin gateway run     # foreground dogfood
#   # or: hermes -p kevin gateway install && hermes -p kevin gateway start

# Copy to hermes/docker/.env (or export in shell) — never commit secrets.
# Path of record: docs/kevin/runbooks/kevin-hermes-docker.md

# Required: absolute path to the product git repo Kevin should edit
KEVIN_PROJECT_ROOT=/absolute/path/to/product-repo

# Hermes data volume (secrets, sessions, installed profile state)
KEVIN_HERMES_DATA=${HOME}/.kevin/hermes-data

# Image (GHCR after CI, or local build tag)
KEVIN_HERMES_IMAGE=ghcr.io/mastercodeyoda/kevin-hermes:main
# KEVIN_HERMES_IMAGE=kevin-hermes:local

# Match host user for volume permissions (Docker Desktop / Linux)
HERMES_UID=1000
HERMES_GID=1000

# Optional: re-apply profile distribution on every start
# KEVIN_FORCE_PROFILE_UPDATE=1

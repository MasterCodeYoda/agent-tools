# Per-profile secrets for Hermes profile jarvis.
# Copy names to live profile .env after install (volume or ~/.hermes/profiles/jarvis/).
# Do NOT commit a real .env. Names only in git.
# Doctrine: docs/kevin/runbooks/multi-agent-config-lanes.md
# Capabilities: docs/kevin/runbooks/jarvis-capabilities.md

# --- Model auth (one working path is enough) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# Or: hermes -p jarvis auth … → auth.json (never commit)

# --- Morning digest email (SMTP) ---
# JARVIS_SMTP_HOST=
# JARVIS_SMTP_PORT=587
# JARVIS_SMTP_USER=
# JARVIS_SMTP_PASSWORD=
# JARVIS_SMTP_STARTTLS=1
# JARVIS_DIGEST_TO=
# JARVIS_DIGEST_FROM=

# --- Slack CoS chat (Socket Mode) — values live only ---
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# SLACK_ALLOWED_USERS=
# SLACK_ALLOWED_CHANNELS=
# SLACK_HOME_CHANNEL=

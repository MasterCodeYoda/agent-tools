#!/usr/bin/env bash
#
# Product CLI for Workstation Kevin (ADR-004).
#
# Operator surface is kevin only — Hermes is the runtime under profile kevin.
#
# Commands:
#   setup | update | doctor | auth | model | configure | start | help | version
#
# Env:
#   KEVIN_HOME          default $HOME/.kevin
#   KEVIN_SKILLS_ROOT   default $KEVIN_HOME/skills
#   KEVIN_PROFILE_SRC   staged profile dist (default $KEVIN_HOME/profile-src)
#   KEVIN_SHARE_DIR     install share (profile + install-kevin-skills); auto-detected
#   KEVIN_SKILLS_URL    override skills download URL
#
set -euo pipefail

CMD_NAME="kevin"
KEVIN_HOME="${KEVIN_HOME:-${HOME}/.kevin}"
SKILLS_ROOT="${KEVIN_SKILLS_ROOT:-${KEVIN_HOME}/skills}"
PROFILE_SRC="${KEVIN_PROFILE_SRC:-${KEVIN_HOME}/profile-src}"
PLACEHOLDER="__HERMES_SKILLS_DIR__"
PROFILE_HOME="${HOME}/.hermes/profiles/kevin"
INSTALLED_CONFIG="${PROFILE_HOME}/config.yaml"
PROFILE_ENV="${PROFILE_HOME}/.env"
PROFILE_AUTH="${PROFILE_HOME}/auth.json"

# Rolling skills channel (AGNT-13) — manifest next to tarball on release tag kevin-skills
DEFAULT_MANIFEST_URL="${KEVIN_SKILLS_MANIFEST_URL:-https://github.com/MasterCodeYoda/agent-tools/releases/download/kevin-skills/manifest.json}"

die() { echo "${CMD_NAME}: error: $*" >&2; exit 1; }
info() { echo "${CMD_NAME}: $*" >&2; }
ok() { echo "  OK   $*"; }
warn() { echo "  WARN $*"; }
fail_hard() { echo "  FAIL $*"; HARD_FAILS=$((HARD_FAILS + 1)); }
soft_note() { echo "  note $*"; }

usage() {
  cat <<'EOF'
kevin — Workstation Kevin (coding agent on your machine)

Bootstrap & stack
  kevin setup   [--from-file TAR] [--force-profile]
  kevin update  [--from-file TAR] [--force-profile]
  kevin doctor  [--project PATH] [--verbose]

Credentials & model (via Hermes profile kevin — use these, not hermes -p)
  kevin auth    …          # list / add / status / remove / …
  kevin model   …          # pick default model & provider
  kevin configure […]     # interactive host configure wizard

Session
  kevin start   [--project PATH] [-- ARGS…]
  kevin                  # same as start
  kevin help
  kevin version

Typical path
  ./tools/install-kevin-cli.sh   # once from agent-tools (or your install channel)
  kevin setup
  kevin auth add anthropic --type oauth   # or another provider you use
  kevin doctor
  cd <product-repo> && kevin

Environment
  KEVIN_HOME          default ~/.kevin
  KEVIN_SKILLS_ROOT   default $KEVIN_HOME/skills
  KEVIN_PROFILE_SRC   staged profile distribution
  KEVIN_SKILLS_URL    skills tarball URL override
  KEVIN_SKILLS_MANIFEST_URL  channel manifest (default: release manifest.json)
  KEVIN_SKILLS_AUTO_CHECK    0 to skip channel check on start (default 1)
  KEVIN_SKILLS_AUTO_UPDATE   1 to update without prompt when stale (default 0)

Skills install into the Kevin skills root (not multi-agent setup.sh → ~/.hermes/skills).
On start, kevin checks the published skills channel and offers kevin update when stale.
EOF
}

# --- path detection ----------------------------------------------------------

resolve_self() {
  local src="${BASH_SOURCE[0]}"
  while [[ -L "$src" ]]; do
    local dir
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="${dir}/${src}"
  done
  cd -P "$(dirname "$src")" && pwd
}

SELF_DIR="$(resolve_self)"

detect_share_dir() {
  if [[ -n "${KEVIN_SHARE_DIR:-}" ]]; then
    echo "$KEVIN_SHARE_DIR"
    return
  fi
  local prefix
  prefix="$(cd "${SELF_DIR}/.." && pwd)"
  if [[ -d "${prefix}/share/kevin" ]]; then
    echo "${prefix}/share/kevin"
    return
  fi
  if [[ -d "${KEVIN_HOME}/share" ]]; then
    echo "${KEVIN_HOME}/share"
    return
  fi
  echo ""
}

detect_repo_root() {
  local candidate
  candidate="$(cd "${SELF_DIR}/../.." && pwd)"
  if [[ -f "${candidate}/hermes/profile/distribution.yaml" ]] \
    && [[ -f "${candidate}/tools/install-kevin-skills.sh" ]]; then
    echo "$candidate"
    return
  fi
  echo ""
}

REPO_ROOT="$(detect_repo_root)"
SHARE_DIR="$(detect_share_dir)"

find_skills_installer() {
  if [[ -n "$REPO_ROOT" && -x "${REPO_ROOT}/tools/install-kevin-skills.sh" ]]; then
    echo "${REPO_ROOT}/tools/install-kevin-skills.sh"
    return
  fi
  if [[ -n "$SHARE_DIR" && -x "${SHARE_DIR}/install-kevin-skills.sh" ]]; then
    echo "${SHARE_DIR}/install-kevin-skills.sh"
    return
  fi
  if [[ -x "${KEVIN_HOME}/share/install-kevin-skills.sh" ]]; then
    echo "${KEVIN_HOME}/share/install-kevin-skills.sh"
    return
  fi
  echo ""
}

find_profile_source() {
  if [[ -n "$REPO_ROOT" && -f "${REPO_ROOT}/hermes/profile/distribution.yaml" ]]; then
    echo "${REPO_ROOT}/hermes/profile"
    return
  fi
  if [[ -n "$SHARE_DIR" && -f "${SHARE_DIR}/profile/distribution.yaml" ]]; then
    echo "${SHARE_DIR}/profile"
    return
  fi
  if [[ -f "${KEVIN_HOME}/share/profile/distribution.yaml" ]]; then
    echo "${KEVIN_HOME}/share/profile"
    return
  fi
  if [[ -f "${PROFILE_SRC}/distribution.yaml" ]]; then
    echo "$PROFILE_SRC"
    return
  fi
  echo ""
}

# --- Hermes runtime (internal only) ------------------------------------------

require_hermes() {
  if command -v hermes >/dev/null 2>&1; then
    return 0
  fi
  cat >&2 <<'EOF'
kevin: error: Hermes runtime not found on PATH

Kevin uses Hermes under profile "kevin". Install Hermes, then re-open your shell:

  curl -fsSL https://hermes-agent.nousresearch.com/install.sh | bash

See https://hermes-agent.nousresearch.com/
EOF
  exit 1
}

# Run Hermes under profile kevin. Operator-facing commands should go through
# kevin wrappers so users never need hermes -p kevin.
run_profile() {
  require_hermes
  hermes -p kevin "$@"
}

profile_exists() {
  command -v hermes >/dev/null 2>&1 && hermes profile show kevin >/dev/null 2>&1
}

is_git_worktree() {
  local dir="$1"
  git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1
}

default_provider() {
  # From installed profile config when present
  if [[ -f "$INSTALLED_CONFIG" ]]; then
    local p
    p="$(awk '
      /^model:[[:space:]]*$/ { in_model=1; next }
      in_model && /^[^[:space:]#]/ { in_model=0 }
      in_model && /^[[:space:]]*provider:[[:space:]]*/ {
        sub(/^[[:space:]]*provider:[[:space:]]*/, "")
        gsub(/[[:space:]]*#.*$/, "")
        gsub(/["'\'']/, "")
        print
        exit
      }
    ' "$INSTALLED_CONFIG" 2>/dev/null || true)"
    if [[ -n "${p:-}" ]]; then
      echo "$p"
      return
    fi
  fi
  echo "anthropic"
}

default_model() {
  if [[ -f "$INSTALLED_CONFIG" ]]; then
    local m
    m="$(awk '
      /^model:[[:space:]]*$/ { in_model=1; next }
      in_model && /^[^[:space:]#]/ { in_model=0 }
      in_model && /^[[:space:]]*default:[[:space:]]*/ {
        sub(/^[[:space:]]*default:[[:space:]]*/, "")
        gsub(/[[:space:]]*#.*$/, "")
        gsub(/["'\'']/, "")
        print
        exit
      }
    ' "$INSTALLED_CONFIG" 2>/dev/null || true)"
    if [[ -n "${m:-}" ]]; then
      echo "$m"
      return
    fi
  fi
  echo ""
}

# Returns 0 if operator has a usable inference credential path.
# Path A: non-empty KEY=value lines in profile .env
# Path B: hermes auth list shows at least one credential block
auth_has_any() {
  if [[ -f "$PROFILE_ENV" ]] && grep -qE '^[A-Za-z_][A-Za-z0-9_]*[[:space:]]*=[[:space:]]*[^[:space:]#]+' "$PROFILE_ENV" 2>/dev/null; then
    return 0
  fi
  if [[ -f "$PROFILE_AUTH" && -s "$PROFILE_AUTH" ]]; then
    # non-empty auth store is a strong signal; still prefer list parse when hermes works
    if command -v hermes >/dev/null 2>&1; then
      local listing
      listing="$(hermes -p kevin auth list 2>/dev/null || true)"
      if echo "$listing" | grep -qiE 'credential|oauth|api_key|api-key'; then
        return 0
      fi
      # auth.json present and non-trivial size even if list parse shape changes
      if [[ "$(wc -c <"$PROFILE_AUTH" | tr -d ' ')" -gt 20 ]]; then
        return 0
      fi
    else
      return 0
    fi
  fi
  return 1
}

# True if default provider appears in auth list (best-effort).
auth_covers_provider() {
  local provider="$1"
  local listing
  listing="$(hermes -p kevin auth list 2>/dev/null || true)"
  [[ -n "$listing" ]] || return 1
  # list format: "anthropic (1 credentials):"
  echo "$listing" | grep -qiE "^${provider}[[:space:]]*\\(" && return 0
  # .env often uses PROVIDER-shaped keys
  if [[ -f "$PROFILE_ENV" ]]; then
    local key
    key="$(echo "$provider" | tr '[:lower:]-' '[:upper:]_')_API_KEY"
    if grep -qE "^${key}[[:space:]]*=[[:space:]]*[^[:space:]#]+" "$PROFILE_ENV" 2>/dev/null; then
      return 0
    fi
    # anthropic special-case
    if [[ "$provider" == "anthropic" ]] && grep -qE '^ANTHROPIC_API_KEY[[:space:]]*=[[:space:]]*[^[:space:]#]+' "$PROFILE_ENV" 2>/dev/null; then
      return 0
    fi
  fi
  return 1
}

auth_summary_lines() {
  # Print non-secret credential summary for doctor
  if ! command -v hermes >/dev/null 2>&1; then
    return
  fi
  local listing
  listing="$(hermes -p kevin auth list 2>/dev/null || true)"
  if [[ -z "$listing" ]]; then
    return
  fi
  # Show provider headers only (e.g. "anthropic (1 credentials):")
  echo "$listing" | grep -E '^[a-zA-Z0-9_-]+[[:space:]]*\(' | sed 's/^/         /' || true
}

# --- skills channel (published release vs local install) ----------------------

local_skills_rev() {
  if [[ -f "${SKILLS_ROOT}/.agent-tools-revision" ]]; then
    grep -E '^agent-tools-rev=' "${SKILLS_ROOT}/.agent-tools-revision" 2>/dev/null \
      | head -1 | cut -d= -f2- || true
  fi
}

# Prints remote git_sha from channel manifest, or empty on failure.
fetch_channel_git_sha() {
  local url="${KEVIN_SKILLS_MANIFEST_URL:-$DEFAULT_MANIFEST_URL}"
  local body
  if ! command -v curl >/dev/null 2>&1; then
    return 0
  fi
  body="$(curl -fsSL --max-time 8 "$url" 2>/dev/null)" || return 0
  if command -v python3 >/dev/null 2>&1; then
    printf '%s' "$body" | python3 -c 'import json,sys
try:
  print(json.load(sys.stdin).get("git_sha",""))
except Exception:
  pass' 2>/dev/null || true
  return 0
  fi
  # minimal fallback
  printf '%s' "$body" | sed -n 's/.*"git_sha"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1
}

# Sets globals: CHANNEL_STATUS=current|stale|unknown  CHANNEL_LOCAL  CHANNEL_REMOTE
# current = local matches published channel; stale = both known and differ; unknown = can't tell
assess_skills_channel() {
  CHANNEL_STATUS="unknown"
  CHANNEL_LOCAL="$(local_skills_rev)"
  CHANNEL_REMOTE="$(fetch_channel_git_sha)"
  CHANNEL_LOCAL="${CHANNEL_LOCAL:-}"
  CHANNEL_REMOTE="${CHANNEL_REMOTE:-}"

  if [[ -z "$CHANNEL_LOCAL" || -z "$CHANNEL_REMOTE" || "$CHANNEL_REMOTE" == "unknown" ]]; then
    CHANNEL_STATUS="unknown"
    return 0
  fi
  # prefix match (full or abbreviated shas)
  if [[ "$CHANNEL_LOCAL" == "$CHANNEL_REMOTE" \
     || "$CHANNEL_LOCAL" == "$CHANNEL_REMOTE"* \
     || "$CHANNEL_REMOTE" == "$CHANNEL_LOCAL"* ]]; then
    CHANNEL_STATUS="current"
  else
    CHANNEL_STATUS="stale"
  fi
}

# Doctor / start messaging. Returns 0 always (soft).
report_skills_channel() {
  # mode: doctor | start
  local mode="${1:-doctor}"
  assess_skills_channel
  case "$CHANNEL_STATUS" in
    current)
      ok "skills channel current (${CHANNEL_LOCAL:0:12}…)"
      ;;
    stale)
      warn "skills channel has a different package"
      soft_note "local:   ${CHANNEL_LOCAL:0:12}…"
      soft_note "channel: ${CHANNEL_REMOTE:0:12}…"
      soft_note "sync:    kevin update"
      ;;
    *)
      if [[ -n "$CHANNEL_LOCAL" ]]; then
        soft_note "skills channel check skipped or offline (local ${CHANNEL_LOCAL:0:12}…)"
      else
        soft_note "skills channel check skipped (no local revision)"
      fi
      ;;
  esac
  if [[ "$mode" == "start" && "$CHANNEL_STATUS" == "stale" ]]; then
    return 2
  fi
  return 0
}

# Interactive (or auto) offer to pull channel. No-op if not stale / check disabled.
maybe_offer_skills_update() {
  if [[ "${KEVIN_SKILLS_AUTO_CHECK:-1}" == "0" ]]; then
    return 0
  fi
  assess_skills_channel
  if [[ "$CHANNEL_STATUS" != "stale" ]]; then
    if [[ "$CHANNEL_STATUS" == "current" ]]; then
      info "skills channel current (${CHANNEL_LOCAL:0:12}…)"
    fi
    return 0
  fi

  warn "installed skills differ from published channel"
  info "  local:   ${CHANNEL_LOCAL}"
  info "  channel: ${CHANNEL_REMOTE}"

  if [[ "${KEVIN_SKILLS_AUTO_UPDATE:-0}" == "1" ]]; then
    info "KEVIN_SKILLS_AUTO_UPDATE=1 — running kevin update"
    cmd_update
    return 0
  fi

  # Prompt only on a real TTY
  if [[ ! -t 0 || ! -t 1 ]]; then
    info "run: kevin update   # then re-launch"
    return 0
  fi

  local ans
  printf '%s' "kevin: update skills from channel now? [Y/n] " >&2
  read -r ans || ans="n"
  case "${ans:-Y}" in
    ""|y|Y|yes|YES)
      cmd_update
      ;;
    *)
      info "skipped — run kevin update when ready"
      ;;
  esac
}

# --- profile / skills bootstrap ----------------------------------------------

stage_profile() {
  local src
  src="$(find_profile_source)"
  [[ -n "$src" ]] || die "no profile distribution found (run tools/install-kevin-cli.sh from agent-tools)"
  if [[ "$src" == "$PROFILE_SRC" ]]; then
    info "profile already staged at ${PROFILE_SRC}"
    return
  fi
  mkdir -p "$PROFILE_SRC"
  if command -v rsync >/dev/null 2>&1; then
    rsync -a --delete "${src}/" "${PROFILE_SRC}/"
  else
    find "$PROFILE_SRC" -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null || true
    cp -a "${src}/." "${PROFILE_SRC}/"
  fi
  [[ -f "${PROFILE_SRC}/distribution.yaml" ]] || die "staged profile missing distribution.yaml"
  info "staged profile → ${PROFILE_SRC}"
}

substitute_skills_path() {
  [[ -f "$INSTALLED_CONFIG" ]] || die "expected installed config at ${INSTALLED_CONFIG}"
  if grep -q "$PLACEHOLDER" "$INSTALLED_CONFIG"; then
    local tmp
    tmp="$(mktemp)"
    sed "s|${PLACEHOLDER}|${SKILLS_ROOT}|g" "$INSTALLED_CONFIG" >"$tmp"
    mv "$tmp" "$INSTALLED_CONFIG"
    info "bound skills path → ${SKILLS_ROOT}"
  elif grep -qF "$SKILLS_ROOT" "$INSTALLED_CONFIG"; then
    info "skills path already set → ${SKILLS_ROOT}"
  else
    if grep -q 'external_dirs:' "$INSTALLED_CONFIG"; then
      local tmp
      tmp="$(mktemp)"
      awk -v root="$SKILLS_ROOT" '
        BEGIN { done=0 }
        /^[[:space:]]*external_dirs:[[:space:]]*$/ {
          print
          getline
          if ($0 ~ /^[[:space:]]*-/) { print "    - " root; done=1; next }
        }
        { print }
      ' "$INSTALLED_CONFIG" >"$tmp"
      mv "$tmp" "$INSTALLED_CONFIG"
      info "rewrote external_dirs → ${SKILLS_ROOT}"
    else
      warn "could not find external_dirs in profile config; set to ${SKILLS_ROOT}"
    fi
  fi
}

apply_profile() {
  local force="${1:-0}"
  require_hermes
  stage_profile
  [[ -d "$SKILLS_ROOT" ]] || die "skills root missing: ${SKILLS_ROOT} (run kevin setup)"

  export HERMES_SKILLS_DIR="$SKILLS_ROOT"
  export KEVIN_SKILLS_ROOT="$SKILLS_ROOT"

  local exists=0
  if profile_exists; then
    exists=1
  fi

  # No --alias: product kevin owns PATH.
  if [[ "$exists" -eq 1 && "$force" -eq 0 ]]; then
    info "profile kevin exists — updating from staged source"
    if ! hermes profile update kevin -y 2>/dev/null; then
      info "update failed or no-op; reinstalling"
      hermes profile install "$PROFILE_SRC" --name kevin --force -y
    fi
  else
    local args=(profile install "$PROFILE_SRC" --name kevin -y)
    if [[ "$exists" -eq 1 || "$force" -eq 1 ]]; then
      args+=(--force)
    fi
    info "installing profile kevin"
    hermes "${args[@]}"
  fi

  substitute_skills_path

  if [[ -f "${PROFILE_SRC}/.no-bundled-skills" ]]; then
    mkdir -p "$PROFILE_HOME"
    cp "${PROFILE_SRC}/.no-bundled-skills" "${PROFILE_HOME}/.no-bundled-skills"
  fi
  info "profile ready"
}

install_skills() {
  local from_file="${1:-}"
  local installer
  installer="$(find_skills_installer)"
  [[ -n "$installer" ]] || die "skills installer not found — re-run tools/install-kevin-cli.sh"

  local args=(--root "$SKILLS_ROOT")
  if [[ -n "$from_file" ]]; then
    args+=(--from-file "$from_file")
  else
    args+=(--from-url)
  fi
  info "installing skills → ${SKILLS_ROOT}"
  KEVIN_SKILLS_ROOT="$SKILLS_ROOT" "$installer" "${args[@]}" >/dev/null
  info "skills installed"
}

print_next_steps() {
  local provider
  provider="$(default_provider)"
  echo >&2
  info "next:"
  info "  kevin doctor"
  if ! auth_has_any; then
    info "  kevin auth add ${provider} --type oauth"
    info "  # or: kevin auth add ${provider} --type api-key"
    info "  # or: kevin model   # interactive provider/model + login"
  else
    info "  kevin auth list    # optional: review credentials"
  fi
  info "  cd <product-repo> && kevin"
}

# --- commands ----------------------------------------------------------------

cmd_setup() {
  local from_file="" force=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --from-file)
        [[ $# -ge 2 ]] || die "--from-file needs a path"
        from_file="$2"
        shift 2
        ;;
      --force-profile) force=1; shift ;;
      -h|--help) usage; exit 0 ;;
      *) die "setup: unknown argument: $1" ;;
    esac
  done

  require_hermes
  install_skills "$from_file"
  apply_profile "$force"
  info "setup complete"
  info "  skills → ${SKILLS_ROOT}"
  print_next_steps
}

cmd_update() {
  local from_file="" force=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --from-file)
        [[ $# -ge 2 ]] || die "--from-file needs a path"
        from_file="$2"
        shift 2
        ;;
      --force-profile) force=1; shift ;;
      -h|--help) usage; exit 0 ;;
      *) die "update: unknown argument: $1" ;;
    esac
  done

  require_hermes
  install_skills "$from_file"
  if [[ "$force" -eq 1 ]] || ! profile_exists; then
    apply_profile 1
  elif [[ -f "$INSTALLED_CONFIG" ]]; then
    substitute_skills_path
  fi
  info "update complete → ${SKILLS_ROOT}"
}

cmd_doctor() {
  local project verbose=0
  project="$(pwd)"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project)
        [[ $# -ge 2 ]] || die "--project needs a path"
        project="$2"
        shift 2
        ;;
      --verbose|-v) verbose=1; shift ;;
      -h|--help) usage; exit 0 ;;
      *) die "doctor: unknown argument: $1" ;;
    esac
  done

  HARD_FAILS=0
  local soft_chat_blockers=0
  local provider model skill_count

  echo "Kevin doctor"
  echo "============"
  echo "Stack"
  echo "-----"

  if command -v hermes >/dev/null 2>&1; then
    local ver
    ver="$(hermes version 2>/dev/null | head -1 || true)"
    ok "Hermes runtime${ver:+ — ${ver}}"
  else
    fail_hard "Hermes runtime not on PATH (install Hermes, then re-open shell)"
  fi

  if profile_exists; then
    ok "profile kevin installed"
  else
    fail_hard "profile kevin missing — run: kevin setup"
  fi

  if [[ -d "$SKILLS_ROOT" ]]; then
    skill_count="$(find "$SKILLS_ROOT" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')"
    ok "skills root ${SKILLS_ROOT} (${skill_count} skill dirs)"
    if [[ -f "${SKILLS_ROOT}/.agent-tools-revision" ]]; then
      ok "skills revision present"
      if [[ "$verbose" -eq 1 ]]; then
        soft_note "revision:"
        sed 's/^/         /' "${SKILLS_ROOT}/.agent-tools-revision"
      fi
      if ! grep -q 'publish-agent=hermes' "${SKILLS_ROOT}/.agent-tools-revision" 2>/dev/null; then
        warn "revision lacks publish-agent=hermes"
      fi
    else
      fail_hard "missing skills revision — run: kevin setup / kevin update"
    fi
  else
    fail_hard "skills root missing: ${SKILLS_ROOT} — run: kevin setup"
  fi

  if [[ -f "$INSTALLED_CONFIG" ]]; then
    if grep -q "$PLACEHOLDER" "$INSTALLED_CONFIG"; then
      fail_hard "skills path placeholder not expanded — run: kevin setup --force-profile"
    else
      ok "skills path bound (no leftover placeholder)"
    fi
    if grep -qF "$SKILLS_ROOT" "$INSTALLED_CONFIG"; then
      ok "external_dirs → Kevin skills root"
    else
      fail_hard "profile does not reference ${SKILLS_ROOT} — run: kevin setup --force-profile"
    fi
  elif profile_exists; then
    fail_hard "profile config missing at ${INSTALLED_CONFIG}"
  fi

  if [[ -d "$project" ]] && is_git_worktree "$project"; then
    ok "project is a git work tree (${project})"
  else
    fail_hard "project is not a git work tree: ${project}"
  fi

  echo
  echo "Skills channel (published release vs local)"
  echo "-------------------------------------------"
  report_skills_channel doctor || true
  if [[ "${CHANNEL_STATUS:-}" == "stale" ]]; then
    soft_note "after CI pack of main: kevin update pulls the live bundle"
  fi

  echo
  echo "Credentials (soft — needed for chat, not for stack install)"
  echo "-----------------------------------------------------------"

  provider="$(default_provider)"
  model="$(default_model)"
  if [[ -n "$model" ]]; then
    soft_note "default model: ${model} (provider: ${provider})"
  else
    soft_note "default provider: ${provider}"
  fi

  if auth_has_any; then
    ok "inference credentials present"
    auth_summary_lines
    if command -v hermes >/dev/null 2>&1 && auth_covers_provider "$provider"; then
      ok "credential covers default provider (${provider})"
    else
      warn "no credential clearly matched to provider '${provider}'"
      soft_note "attach: kevin auth add ${provider} --type oauth"
      soft_note "   or: kevin auth add ${provider} --type api-key"
      soft_note "   or: kevin model"
      soft_chat_blockers=$((soft_chat_blockers + 1))
    fi
    if [[ -f "$PROFILE_ENV" ]]; then
      soft_note "profile .env present (API-key / env-style secrets path)"
    fi
  else
    warn "no inference credentials yet — chat will fail until you attach one"
    soft_note "recommended: kevin auth add ${provider} --type oauth"
    soft_note "         or: kevin auth add ${provider} --type api-key"
    soft_note "         or: kevin model"
    soft_chat_blockers=$((soft_chat_blockers + 1))
  fi

  if [[ "$verbose" -eq 1 ]] && command -v hermes >/dev/null 2>&1 && profile_exists; then
    echo
    echo "Runtime doctor (verbose — Hermes internals; ignore .env nags if auth list is green)"
    echo "--------------------------------------------------------------------------------"
    set +e
    hermes -p kevin doctor 2>&1 | sed 's/^/  /'
    set -e
  fi

  echo
  echo "============"
  if [[ "$HARD_FAILS" -gt 0 ]]; then
    echo "RESULT: FAIL (${HARD_FAILS} hard check(s))"
    echo "Fix stack issues above, then re-run: kevin doctor"
    return 1
  fi
  if [[ "$soft_chat_blockers" -gt 0 ]]; then
    echo "RESULT: PASS (stack) · CHAT NOT READY (${soft_chat_blockers} credential gap(s))"
    return 0
  fi
  echo "RESULT: PASS (stack + credentials look ready for chat)"
  return 0
}

cmd_auth() {
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    cat <<'EOF'
kevin auth — manage inference credentials for profile kevin

Examples:
  kevin auth list
  kevin auth add anthropic --type oauth
  kevin auth add anthropic --type api-key
  kevin auth status anthropic
  kevin auth remove …

Credentials may live in the Hermes auth store and/or profile .env.
You do not need a .env file if OAuth / pooled login already covers your model.
EOF
    exit 0
  fi
  # Default to list when bare `kevin auth`
  if [[ $# -eq 0 ]]; then
    run_profile auth list
    return
  fi
  run_profile auth "$@"
}

cmd_model() {
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    cat <<'EOF'
kevin model — choose default inference provider/model for profile kevin

Runs the interactive model picker under Kevin's profile.
EOF
    exit 0
  fi
  run_profile model "$@"
}

cmd_configure() {
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    cat <<'EOF'
kevin configure — interactive host configuration for profile kevin

Wraps the Hermes setup wizard under Kevin's profile (model, tools, etc.).
For credentials only, prefer: kevin auth …  or  kevin model
EOF
    exit 0
  fi
  run_profile setup "$@"
}

cmd_start() {
  local project
  project="$(pwd)"
  local passthrough=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project)
        [[ $# -ge 2 ]] || die "--project needs a path"
        project="$2"
        shift 2
        ;;
      --)
        shift
        passthrough+=("$@")
        break
        ;;
      -h|--help) usage; exit 0 ;;
      *)
        passthrough+=("$1")
        shift
        ;;
    esac
  done

  require_hermes
  [[ -d "$project" ]] || die "project path not found: ${project}"
  is_git_worktree "$project" || die "project is not a git work tree: ${project}"

  if ! profile_exists; then
    die "profile kevin missing — run: kevin setup"
  fi

  if ! auth_has_any; then
    local provider
    provider="$(default_provider)"
    warn "no inference credentials detected — chat will likely fail"
    info "attach credentials: kevin auth add ${provider} --type oauth"
    info "                or: kevin model"
  fi

  # Offer channel sync before session (TTY prompt / AUTO_UPDATE)
  maybe_offer_skills_update

  cd "$project" || die "cannot cd to ${project}"
  # Hint identity envelope for work-family hosts (runs-ledger capture)
  export KEVIN_RUN_HARNESS="${KEVIN_RUN_HARNESS:-kevin-hermes}"
  export KEVIN_RUN_PROFILE="${KEVIN_RUN_PROFILE:-kevin}"
  if [[ -f "${SKILLS_ROOT}/.agent-tools-revision" ]]; then
    local _skills_rev
    _skills_rev="$(
      grep -E '^agent-tools-rev=' "${SKILLS_ROOT}/.agent-tools-revision" 2>/dev/null \
        | head -1 | cut -d= -f2-
    )" || true
    export KEVIN_RUN_SKILLS_REV="${_skills_rev:-}"
  fi
  info "starting Kevin in ${project}"
  exec hermes -p kevin "${passthrough[@]}"
}

main() {
  local cmd="${1:-start}"
  if [[ $# -gt 0 ]]; then
    shift
  fi
  case "$cmd" in
    setup) cmd_setup "$@" ;;
    update) cmd_update "$@" ;;
    doctor) cmd_doctor "$@" ;;
    auth) cmd_auth "$@" ;;
    model) cmd_model "$@" ;;
    configure|config) cmd_configure "$@" ;;
    start) cmd_start "$@" ;;
    help|-h|--help) usage ;;
    version|--version)
      echo "kevin (workstation CLI)"
      if [[ -f "${SKILLS_ROOT}/.agent-tools-revision" ]]; then
        echo "skills:"
        sed 's/^/  /' "${SKILLS_ROOT}/.agent-tools-revision"
      fi
      if profile_exists 2>/dev/null; then
        local provider model
        provider="$(default_provider)"
        model="$(default_model)"
        [[ -n "$model" ]] && echo "model: ${model} (${provider})"
      fi
      ;;
    *)
      if [[ "$cmd" == -* ]]; then
        cmd_start "$cmd" "$@"
      else
        die "unknown command: ${cmd} (try: kevin help)"
      fi
      ;;
  esac
}

main "$@"
